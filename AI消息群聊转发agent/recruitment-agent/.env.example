# Copy to .env and fill real values. Do not commit .env.

# Chrome CDP. Start Chrome with --remote-debugging-port=9222 and log in to the enabled platforms first.
CDP_HOST=127.0.0.1
CDP_PORT=9222
AUTO_START_CDP=false
# Leave empty to auto-detect Chrome. Set only when Chrome is installed elsewhere.
CHROME_PATH=
CHROME_CDP_PROFILE_DIR=

# Workflow mode: draft only by default. Use SEND_MODE=send only after you confirm the draft flow.
SEND_MODE=draft
SCHEDULE_SEND_MODE=draft
ENABLE_COLLECT=false
ENABLE_LOGIN_CHECK=true
ENABLE_SCREEN=true
ENABLE_EVALUATE=true
ENABLE_PUSH=false
ENABLE_JOB_STORE=false
ENABLE_STATUS_REFRESH=false
ENABLE_BOSS=false
ENABLE_LIEPIN=false
MAX_TOTAL=50
PER_KEYWORD=8
SCHEDULE_MAX_TOTAL=30
SCHEDULE_PER_KEYWORD=5
LIEPIN_MAX_TOTAL=20
LIEPIN_PER_KEYWORD=4
LIEPIN_ENABLE_DETAIL=false
JOB_STORE_PATH=
JOB_CLOSE_AFTER_MISSING_DAYS=7
SCHEDULE_LIEPIN_MAX_TOTAL=20
SCHEDULE_LIEPIN_PER_KEYWORD=4
SCHEDULE_WORKFLOW_TIMEOUT_MINUTES=45
SCHEDULE_MIN_COLLECTION_GAP_HOURS=2
SCHEDULE_REPORT_START_HOUR=19
SCHEDULE_REPORT_END_HOUR=21

# Push channels. Values: none, app, webhook.
FEISHU_SEND_MODE=app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# FEISHU_TEST_CHAT_ID from the old env is also accepted as FEISHU_CHAT_ID.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Email SMTP. SMTP_PASSWORD or SMTP_PASS are both accepted.
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=

# Report options.
REPORT_TITLE=岗位搜索汇总
REPORT_TOP_N=8
REPORT_SPLIT_BY_PLATFORM=true

# Greeting recommender / AI.
# rules: local template only, default for the public package.
# auto/ai: try configured Codex runtime first, then OpenAI-compatible API.
# Codex runtime requires CODEX_RUNTIME_COMMAND; the repository does not include any Codex account or API key.
GREETING_MODE=rules
GREETING_AI_PROVIDER_ORDER=codex_runtime,openai_api
CODEX_RUNTIME_COMMAND=
CODEX_RUNTIME_TIMEOUT_MS=15000
GREETING_MAX_LENGTH=200
GREETING_AI_FALLBACK=true
GREETING_AI_TIMEOUT_MS=15000
GREETING_AI_MAX_OUTPUT_TOKENS=220
GREETING_OPENAI_MODEL=gpt-5.6
GREETING_OPENAI_BASE_URL=https://api.openai.com/v1
# GREETING_OPENAI_API_KEY= or OPENAI_API_KEY=
SIMILAR_JOB_THRESHOLD=0.8
SIMILAR_JOB_WINDOW_DAYS=45

# Current recommender profile. `candidate-profile` can regenerate the Markdown profile from resume text.
# PROFILE_OPENAI_API_KEY= falls back to OPENAI_API_KEY or GREETING_OPENAI_API_KEY.
# PROFILE_OPENAI_MODEL=gpt-5.6
# PROFILE_OPENAI_BASE_URL=https://api.openai.com/v1
# PROFILE_AI_MAX_OUTPUT_TOKENS=2200
