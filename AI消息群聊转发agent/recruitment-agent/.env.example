# Copy to .env and fill real values. Do not commit .env.

# Chrome CDP. Start Chrome with --remote-debugging-port=9222 and log in to the enabled platforms first.
CDP_HOST=127.0.0.1
CDP_PORT=9222
AUTO_START_CDP=false
# Leave empty to auto-detect Chrome. Set only when Chrome is installed elsewhere.
CHROME_PATH=
CHROME_CDP_PROFILE_DIR=

# Workflow mode: draft only by default. Use SEND_MODE=send only after you confirm the draft flow.
SEND_MODE=draft
SCHEDULE_SEND_MODE=draft
ENABLE_COLLECT=false
ENABLE_LOGIN_CHECK=true
ENABLE_SCREEN=true
ENABLE_EVALUATE=true
ENABLE_PUSH=false
ENABLE_JOB_STORE=false
ENABLE_STATUS_REFRESH=false
ENABLE_BOSS=false
ENABLE_LIEPIN=false
MAX_TOTAL=50
PER_KEYWORD=8
SCHEDULE_MAX_TOTAL=30
SCHEDULE_PER_KEYWORD=5
LIEPIN_MAX_TOTAL=20
LIEPIN_PER_KEYWORD=4
LIEPIN_ENABLE_DETAIL=false
JOB_STORE_PATH=
JOB_CLOSE_AFTER_MISSING_DAYS=7
SCHEDULE_LIEPIN_MAX_TOTAL=20
SCHEDULE_LIEPIN_PER_KEYWORD=4
SCHEDULE_WORKFLOW_TIMEOUT_MINUTES=45
SCHEDULE_MIN_COLLECTION_GAP_HOURS=2
SCHEDULE_REPORT_START_HOUR=19
SCHEDULE_REPORT_END_HOUR=21

# Push channels. Values: none, app, webhook.
FEISHU_SEND_MODE=app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# FEISHU_TEST_CHAT_ID from the old env is also accepted as FEISHU_CHAT_ID.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Email SMTP. SMTP_PASSWORD or SMTP_PASS are both accepted.
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=

# Report options.
REPORT_TITLE=岗位搜索汇总
REPORT_TOP_N=8
REPORT_SPLIT_BY_PLATFORM=true

# Unified AI Router. The public package is disabled by default: it never invokes Codex or an API
# until the user explicitly changes AI_DEFAULT_MODE to auto/codex_runtime/openai_api.
AI_DEFAULT_MODE=disabled
AI_DEFAULT_PROVIDER_ORDER=codex_runtime,openai_api
AI_DEFAULT_MODEL=
AI_DEFAULT_TIMEOUT_MS=90000
AI_DEFAULT_MAX_OUTPUT_TOKENS=1200
# Leave empty to run local `codex exec` after the user has signed in to Codex. A custom bridge is optional.
CODEX_RUNTIME_COMMAND=
CODEX_RUNTIME_BIN=codex
# Optional OpenAI-compatible fallback; leave blank until deliberately configured.
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-5.6

# Per-step overrides. Leave blank to inherit the global default. A failed step configuration retries the full default route.
# Modes: auto, codex_runtime, openai_api, rules, disabled.
AI_GREETING_MODE=
AI_GREETING_MODEL=
AI_GREETING_PROVIDER_ORDER=
AI_PROFILE_MODE=
AI_PROFILE_MODEL=
AI_PROFILE_PROVIDER_ORDER=
AI_FIT_EVALUATION_MODE=
AI_FIT_EVALUATION_MODEL=
AI_FIT_EVALUATION_PROVIDER_ORDER=
AI_SEARCH_KEYWORDS_MODE=
AI_SEARCH_KEYWORDS_MODEL=
AI_SEARCH_KEYWORDS_PROVIDER_ORDER=

# Leave blank to inherit AI_DEFAULT_MODE; set rules only when this one step must never call AI.
GREETING_MODE=
GREETING_AI_FALLBACK=true
GREETING_MAX_LENGTH=200
AI_GREETING_MAX_OUTPUT_TOKENS=220
AI_PROFILE_MAX_OUTPUT_TOKENS=2200
AI_FIT_EVALUATION_MAX_ROWS=40
SIMILAR_JOB_THRESHOLD=0.8
SIMILAR_JOB_WINDOW_DAYS=45
