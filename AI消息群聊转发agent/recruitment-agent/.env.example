# Copy to .env and fill real values. Do not commit .env.

# Chrome CDP. Start Chrome with --remote-debugging-port=9222 and log in to the enabled platforms first.
CDP_HOST=127.0.0.1
CDP_PORT=9222
AUTO_START_CDP=true
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_CDP_PROFILE_DIR=

# Workflow mode: draft only by default. Use SEND_MODE=send only after you confirm the draft flow.
SEND_MODE=draft
SCHEDULE_SEND_MODE=send
ENABLE_COLLECT=true
ENABLE_LOGIN_CHECK=true
ENABLE_SCREEN=true
ENABLE_EVALUATE=true
ENABLE_PUSH=true
ENABLE_JOB_STORE=true
ENABLE_STATUS_REFRESH=true
ENABLE_BOSS=true
ENABLE_LIEPIN=false
MAX_TOTAL=50
PER_KEYWORD=8
SCHEDULE_MAX_TOTAL=30
SCHEDULE_PER_KEYWORD=5
LIEPIN_MAX_TOTAL=20
LIEPIN_PER_KEYWORD=4
LIEPIN_ENABLE_DETAIL=false
JOB_STORE_PATH=
JOB_CLOSE_AFTER_MISSING_DAYS=7
SCHEDULE_LIEPIN_MAX_TOTAL=20
SCHEDULE_LIEPIN_PER_KEYWORD=4
SCHEDULE_WORKFLOW_TIMEOUT_MINUTES=45
SCHEDULE_MIN_COLLECTION_GAP_HOURS=2
SCHEDULE_REPORT_START_HOUR=19
SCHEDULE_REPORT_END_HOUR=21
# Failed or partial evening reports retry inside the 19:00-21:00 window after this gap.
SCHEDULE_REPORT_RETRY_GAP_MINUTES=30

# Push channels. Values: none, app, webhook.
FEISHU_SEND_MODE=app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# FEISHU_TEST_CHAT_ID from the old env is also accepted as FEISHU_CHAT_ID.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Email SMTP. SMTP_PASSWORD or SMTP_PASS are both accepted.
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=

# Report options.
REPORT_TITLE=岗位搜索汇总
REPORT_TOP_N=8
REPORT_SPLIT_BY_PLATFORM=true

# Unified AI Router. Provider order defaults to local Codex CLI (using its existing login/session),
# then OpenAI-compatible API. No API key is needed for the Codex CLI provider.
AI_DEFAULT_MODE=auto
AI_DEFAULT_PROVIDER_ORDER=codex_runtime,openai_api
AI_DEFAULT_MODEL=
AI_DEFAULT_TIMEOUT_MS=90000
# Handshake window: wait this long for the model process to *start producing output*
# before killing it (assumed never started). Kept in sync with AI_DEFAULT_TIMEOUT_MS above.
AI_DEFAULT_HANDSHAKE_TIMEOUT_MS=90000
# Overall budget once the run has started (streaming keeps going). Default 30 minutes,
# so a model that is genuinely working is never cut by a short fixed timeout.
AI_DEFAULT_TOTAL_TIMEOUT_MS=1800000
AI_DEFAULT_MAX_OUTPUT_TOKENS=1200
# Optional custom bridge command. Leave empty to run local `codex exec`; when AI_DEFAULT_MODEL is blank,
# Codex uses the model configured for the local logged-in Codex account.
CODEX_RUNTIME_COMMAND=
CODEX_RUNTIME_BIN=codex
# Optional OpenAI-compatible API fallback.
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-5.6

# Per-step overrides. Leave blank to inherit the defaults above. When a per-step provider fails,
# the router automatically tries AI_DEFAULT_PROVIDER_ORDER and records every attempt in logs/ai_calls.log.
# Values for *_MODE: auto, codex_runtime, openai_api, rules, disabled.
AI_GREETING_MODE=
AI_GREETING_MODEL=
AI_GREETING_PROVIDER_ORDER=
AI_PROFILE_MODE=
AI_PROFILE_MODEL=
AI_PROFILE_PROVIDER_ORDER=
AI_FIT_EVALUATION_MODE=
AI_FIT_EVALUATION_MODEL=
AI_FIT_EVALUATION_PROVIDER_ORDER=
AI_SEARCH_KEYWORDS_MODE=
AI_SEARCH_KEYWORDS_MODEL=
AI_SEARCH_KEYWORDS_PROVIDER_ORDER=

# Fallback policies: greeting/scoring/keywords use deterministic rules/static strategy when AI is unavailable;
# candidate profile construction has no factual rule fallback and returns an explicit AI-unavailable error.
GREETING_AI_FALLBACK=true
GREETING_MAX_LENGTH=200
AI_GREETING_MAX_OUTPUT_TOKENS=220
AI_PROFILE_MAX_OUTPUT_TOKENS=2200
AI_FIT_EVALUATION_MAX_ROWS=40
SIMILAR_JOB_THRESHOLD=0.8
SIMILAR_JOB_WINDOW_DAYS=45
