{
  "name": "boss-job-agent",
  "version": "1.5.2",
  "private": true,
  "main": "electron/main.js",
  "description": "BOSS job collection, fit evaluation, draft-first daily push workflow, desktop client.",
  "scripts": {
    "electron": "electron --no-sandbox .",
    "doctor": "node src/v14/cli/doctor.js",
    "path:audit": "node src/v14/cli/path_audit.js",
    "v14:serve": "node src/v14/cli/serve.js",
    "v14:seed-demo": "node src/v14/cli/seed_demo.js",
    "v14:clear-demo": "node src/v14/cli/clear_demo.js",
    "daily": "node src/main/daily_workflow.js",
    "scheduled": "node src/main/scheduled_entry.js",
    "watchdog": "node src/main/report_watchdog.js",
    "login-check": "node src/platforms/boss/check_boss_login_status.js",
    "login-check-new-tab": "node src/platforms/boss/check_boss_login_status.js --new",
    "liepin-login-check": "node src/platforms/liepin/check_liepin_login_status.js",
    "liepin-open": "node tools/open_liepin_page.js",
    "liepin-collect": "node src/platforms/liepin/liepin_batch_collect.js",
    "draft": "node src/push/job_push_draft_and_send.js",
    "send": "node src/push/send_existing_draft.js",
    "job-store": "node src/store/job_store_update.js",
    "status-refresh": "node src/store/job_store_update.js refresh",
    "greeting": "node src/greeting/generate_greeting_for_job.js",
    "greeting-agent": "node src/greeting/job_greeting_agent.js",
    "candidate-profile": "node src/greeting/build_candidate_profile.js",
    "collect": "node src/platforms/boss/boss_batch_collect.js",
    "ingest": "node src/ingest/job_ingest.js",
    "score": "node src/evaluate/score_jobs.js",
    "rescore": "node src/evaluate/score_jobs.js --from-store",
    "screen": "node src/ingest/job_ingest.js",
    "evaluate": "node src/evaluate/score_jobs.js",
    "legacy-screen": "node src/platforms/boss/postprocess_boss_stage2.js",
    "legacy-evaluate": "node src/evaluate/evaluate_job_fit.js",
    "v14:ingest": "node src/v14/cli/ingest_queue.js",
    "v14:migrate": "node src/v14/cli/migrate_v13.js",
    "test:v14": "node --test tests/v14_ingest_queue.test.js tests/v14_roles_scores.test.js tests/v14_scheduler_tasks.test.js tests/v14_runtime.test.js tests/v14_services.test.js tests/v14_api.test.js tests/v14_chat.test.js tests/v14_jobs_recheck.test.js tests/v14_keywords.test.js",
    "build:win": "npm run prepare:runtime && electron-builder --win nsis",
    "build:mac": "npm run prepare:runtime && electron-builder --mac dmg",
    "prepare:runtime": "node scripts/prepare-runtime.js"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aaron.localjobagent",
    "productName": "招聘智能体",
    "copyright": "Local Job Agent",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "招聘智能体-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "招聘智能体-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "招聘智能体"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
