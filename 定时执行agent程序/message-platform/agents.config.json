{
  "agents": [
    {
      "agent_id": "job_greeting_agent",
      "name": "岗位打招呼生成 Agent",
      "description": "调用招聘信息智能体，根据岗位信息或招聘要求生成 100-200 字的招聘平台打招呼消息，并可回发群聊。",
      "enabled": true,
      "input_schema": {
        "clean_text": "用户真实消息正文，已脱掉@、命令前缀和引用噪声。",
        "source": "消息来源渠道，例如 feishu。",
        "chat_id": "来源群聊 ID。",
        "job_record": "由 A004、B001 等岗位编号解析得到的岗位档案。",
        "agent_prompt": "包含用户指令、岗位档案、候选人事实和会话摘要的下游智能体提示词。",
        "session": "多轮任务会话信息。",
        "attachments": "图片、文件等附件元数据。"
      },
      "output_schema": {
        "reply_text": "发回群聊的文本结果。",
        "session_update": "要写回 task_session 的摘要和引用。"
      },
      "executor_type": "job_greeting",
      "executor_config": {
        "max_greeting_chars": 160,
        "candidate_profile_path": "../../AI消息群聊转发agent/recruitment-agent/config/candidate_profiles/sample_candidate.md",
        "recruitment_agent_module": "../../AI消息群聊转发agent/recruitment-agent/src/greeting/job_greeting_agent.js",
        "interface_version": "job_greeting/v1",
        "prompt_template_path": "prompts/job_greeting_agent.md",
        "context_resolution": "按用户消息中的 A001/B001 等岗位编号查询新设备运行后生成的 job_display_index.json，并调用招聘信息智能体。AI 仅在已经选定该 Agent 后，辅助区分新任务或续接上下文。"
      },
      "side_effect_policy": {
        "can_send_message": true,
        "can_write_files": true,
        "can_run_shell": false,
        "can_apply_jobs": false,
        "can_change_config": false
      },
      "requires_confirmation": [
        "apply_job",
        "send_to_recruiter",
        "change_config",
        "run_shell"
      ]
    },
    {
      "agent_id": "ping_agent",
      "name": "连通性测试 Agent",
      "description": "用于验证群消息桥接链路是否可用。",
      "enabled": true,
      "input_schema": {
        "clean_text": "ping 或测试消息。"
      },
      "output_schema": {
        "reply_text": "pong 或诊断结果。"
      },
      "executor_type": "ping",
      "executor_config": {},
      "side_effect_policy": {
        "can_send_message": true,
        "can_write_files": false,
        "can_run_shell": false,
        "can_apply_jobs": false,
        "can_change_config": false
      },
      "requires_confirmation": []
    }
  ]
}
