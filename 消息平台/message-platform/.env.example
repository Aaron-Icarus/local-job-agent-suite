# Copy to .env and provide credentials for your own Feishu app and test group.
# Never commit or share the completed .env file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TEST_CHAT_ID=
FEISHU_CHAT_ID=
FEISHU_EVENT_VERIFY_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
# 默认只允许本机访问 HTTP 事件服务。只有配合可信反向代理时才修改。
HTTP_HOST=127.0.0.1
# HTTP 回调默认必须鉴权。Verification Token 用于确认请求来自你的飞书应用；
# Encrypt Key 配置后还会校验 X-Lark-Signature。时间戳超过 5 分钟或 nonce 重放会拒绝。
FEISHU_HTTP_CALLBACK_REQUIRE_AUTH=true
FEISHU_HTTP_CALLBACK_MAX_SKEW_SECONDS=300

# Optional: explicit path to the recruitment Agent's notification CLI.
# MESSAGE_GATEWAY_CLI=
